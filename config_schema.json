{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Trevor's World Plugin Configuration",
  "description": "Configuration schema for Trevor's World test plugin",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable or disable this plugin"
    },
    "message": {
      "type": "string",
      "default": "Trevor's Test Plug-in",
      "minLength": 1,
      "maxLength": 50,
      "description": "The greeting message to display"
    },
    "font_family": {
      "type": "string",
      "enum": ["press_start", "four_by_six", "tom_thumb", "tiny", "picopixel"],
      "default": "press_start",
      "description": "Font family for countdown text"
    },
    "message_font_size": {
      "type": "integer",
      "default": 10,
      "minimum": 1,
      "maximum": 100,
      "description": "Font size for the message text"
    },
    "show_time": {
      "type": "boolean",
      "default": true,
      "description": "Show the current time below the message"
    },
    "time_font_size": {
      "type": "integer",
      "default": 8,
      "minimum": 1,
      "maximum": 100,
      "description": "Font size for the time text"
    },
    "color": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [255, 255, 255],
      "description": "RGB color for the message text [R, G, B]"
    },
    "time_color": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [0, 255, 255],
      "description": "RGB color for the time text [R, G, B]"
    },
    "display_duration": {
      "type": "number",
      "default": 10,
      "minimum": 1,
      "maximum": 300,
      "description": "How long to display in seconds"
    }
  },
  "required": ["enabled"],
  "additionalProperties": false
}

