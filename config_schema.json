{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trevor's World Plugin Configuration",
  "type": "object",
  "additionalProperties": false,

  "required": ["enabled"],

  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },

    "queue_mode": {
      "type": "boolean",
      "default": true,
      "description": "Enable message queue mode"
    },

    "messages": {
      "type": "array",
      "title": "Message Queue",
      "description": "Manage messages displayed on the LED matrix",
      "x-widget": "array-table",
      "x-columns": ["enabled", "message", "display_duration", "order", "show_time"],
      "default": [],
      "items": {
        "type": "object",
        "title": "Message Entry",
        "additionalProperties": false,

        "required": ["message"],

        "properties": {
          "id": {
            "type": "string",
            "title": "ID",
            "x-display": "hidden"
          },

          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true,
            "description": "Uncheck to disable this message in the queue"
          },

          "message": {
            "type": "string",
            "title": "Message",
            "minLength": 1,
            "maxLength": 100
          },

          "order": {
            "type": "integer",
            "title": "Order",
            "minimum": 0,
            "default": 0
          },

          "display_duration": {
            "type": "number",
            "title": "Duration",
            "minimum": 0.5,
            "maximum": 300,
            "description": "Override display duration (seconds)"
          },

          "color": {
            "type": "array",
            "title": "Color",
            "items": { "type": "integer", "minimum": 0, "maximum": 255 },
            "minItems": 3,
            "maxItems": 3
          },

          "time_color": {
            "type": "array",
            "title": "Time Color",
            "items": { "type": "integer", "minimum": 0, "maximum": 255 },
            "minItems": 3,
            "maxItems": 3
          },

          "show_time": {
            "type": "boolean",
            "title": "Show Time"
          },

          "message_font_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },

          "time_font_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },

          "scroll": {
            "type": "object",
            "title": "Scroll Override",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "speed": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 10
              },
              "delay": {
                "type": "number",
                "minimum": 0.001,
                "maximum": 0.1
              }
            }
          }
        }
      }
    },

    "default_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "default": "Trevor's Plugin"
    },

    "empty_queue_message": {
      "type": "string",
      "default": "Queue Empty",
      "minLength": 1,
      "maxLength": 50
    },

    "font_family": {
      "type": "string",
      "enum": ["press_start", "four_by_six", "tom_thumb", "tiny", "picopixel"],
      "default": "press_start"
    },

    "display_duration": {
      "type": "number",
      "minimum": 1,
      "maximum": 300,
      "default": 10,
      "description": "Default duration per message"
    },

    "color": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 255 },
      "minItems": 3,
      "maxItems": 3,
      "default": [255, 255, 255]
    },

    "time_color": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 255 },
      "minItems": 3,
      "maxItems": 3,
      "default": [0, 255, 255]
    },

    "show_time": {
      "type": "boolean",
      "default": true
    },

    "message_font_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10
    },

    "time_font_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 8
    },

    "scroll": {
      "type": "object",
      "title": "Scroll Settings",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "speed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "default": 1
        },
        "delay": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.1,
          "default": 0.01
        },
        "loop": {
          "type": "boolean",
          "default": true
        },
        "gap_width": {
          "type": "number",
          "minimum": 0,
          "default": 32
        }
      }
    },

    "cache_file": {
      "type": "string",
      "default": ".trevor_world_queue_state"
    }
  }
}