{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trevor's World Plugin Configuration",
  "type": "object",
  "additionalProperties": false,

  "required": ["enabled", "messages"],

  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },

    "messages": {
      "type": "array",
      "title": "Message List",
      "description": "List of messages to display. Each message displays for its configured duration with a random number (1-10) appended.",
      "x-widget": "array-table",
      "x-columns": ["message", "display_duration", "color"],
      "minItems": 1,
      "items": {
        "type": "object",
        "title": "Message",
        "additionalProperties": false,

        "required": ["message"],

        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "minLength": 1,
            "maxLength": 100,
            "description": "Text to display (a random number 1-10 will be appended)"
          },

          "display_duration": {
            "type": "number",
            "title": "Display Duration",
            "minimum": 0.5,
            "maximum": 300,
            "default": 5,
            "description": "Seconds to display this message before moving to next"
          },

          "color": {
            "type": "array",
            "title": "Color",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "RGB color [R, G, B] for this message (0-255 each)"
          }
        }
      }
    },

    "font_family": {
      "type": "string",
      "enum": ["press_start", "four_by_six", "tom_thumb", "tiny", "picopixel"],
      "default": "press_start",
      "description": "Font family to use for messages"
    },

    "message_font_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10,
      "description": "Font size in pixels"
    },

    "color": {
      "type": "array",
      "title": "Default Color",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [255, 255, 255],
      "description": "Default RGB color [R, G, B] for messages (0-255 each)"
    },

    "display_duration": {
      "type": "number",
      "minimum": 1,
      "maximum": 300,
      "default": 5,
      "description": "Default duration (seconds) to display each message"
    },

    "font_path": {
      "type": "string",
      "default": "assets/fonts/PressStart2P-Regular.ttf",
      "description": "Path to font file (relative to project root)"
    }
  }
}
