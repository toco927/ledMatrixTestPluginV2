{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Trevor's World Plugin Configuration",
  "additionalProperties": false,

  "required": ["enabled"],

  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },

    "queue_mode": {
      "type": "boolean",
      "default": false
    },

    "font_family": {
      "type": "string",
      "enum": ["press_start", "four_by_six", "tom_thumb", "tiny", "picopixel"],
      "default": "press_start"
    },

    "display_duration": {
      "type": "number",
      "minimum": 1,
      "maximum": 300,
      "default": 10
    },

    "color": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 255 },
      "minItems": 3,
      "maxItems": 3,
      "default": [255, 255, 255]
    },

    "time_color": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 255 },
      "minItems": 3,
      "maxItems": 3,
      "default": [0, 255, 255]
    },

    "show_time": {
      "type": "boolean",
      "default": true
    },

    "message_font_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10
    },

    "time_font_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 8
    },

    "scroll": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "speed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "default": 1
        },
        "delay": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 0.1,
          "default": 0.01
        },
        "loop": {
          "type": "boolean",
          "default": true
        },
        "gap_width": {
          "type": "number",
          "minimum": 0,
          "default": 32
        }
      }
    },

    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },

    "empty_queue_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "default": "Queue Empty"
    },

    "cache_file": {
      "type": "string",
      "default": ".trevor_world_queue_state"
    },

    "message_queue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message"],
        "properties": {
          "id": { "type": "string" },
          "order": { "type": "integer", "minimum": 0 },

          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },

          "display_duration": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 300
          },

          "color": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 255 },
            "minItems": 3,
            "maxItems": 3
          },

          "time_color": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 255 },
            "minItems": 3,
            "maxItems": 3
          },

          "show_time": { "type": "boolean" },

          "message_font_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },

          "time_font_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },

          "scroll": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "speed": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 10
              },
              "delay": {
                "type": "number",
                "minimum": 0.001,
                "maximum": 0.1
              }
            }
          },

          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  },

  "allOf": [
    {
      "if": {
        "properties": { "queue_mode": { "const": true } }
      },
      "then": {
        "required": ["message_queue"]
      }
    },
    {
      "if": {
        "properties": { "queue_mode": { "const": false } }
      },
      "then": {
        "required": ["message"]
      }
    }
  ]
}